<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RingDeck</AssemblyName>
    <RootNamespace>RingDeck.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../ringdeck.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Resource Include="../ringdeck.ico" Link="ringdeck.ico" />
    <ProjectReference Include="../RingDeck.Core/RingDeck.Core.csproj" />
    <ProjectReference Include="../RingDeck.Windows/RingDeck.Windows.csproj" />
  </ItemGroup>
</Project>
