<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RingDeck</AssemblyName>
    <RootNamespace>RingDeck.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../ringdeck.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Resource Include="../ringdeck.ico" Link="ringdeck.ico" />
    <Resource Include="Assets/FluentSystemIcons-Regular.ttf" />
    <Resource Include="Assets/icons.json" />
    <Resource Include="Assets/emoji.zip" />
    <Resource Include="Assets/brands.zip" />
    <Resource Include="Assets/open.wav" />
    <Resource Include="Assets/select.wav" />
    <ProjectReference Include="../RingDeck.Core/RingDeck.Core.csproj" />
    <ProjectReference Include="../RingDeck.Windows/RingDeck.Windows.csproj" />
  </ItemGroup>
</Project>
