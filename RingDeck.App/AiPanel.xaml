<Window x:Class="RingDeck.App.AiPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RingDeck AI" Width="540" Height="580" MinWidth="380" MinHeight="320"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="True" PreviewKeyDown="OnKey">
  <Grid Margin="14,10,14,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="2,0,2,8">
      <TextBlock x:Name="modelText" DockPanel.Dock="Right" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
      <TextBlock x:Name="nameText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource StageBrush}" Padding="4">
      <ScrollViewer x:Name="scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="transcript" Margin="6" />
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <Button x:Name="sendButton" DockPanel.Dock="Right" Content="Send" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="OnSend" />
      <TextBox x:Name="inputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="160"
               VerticalScrollBarVisibility="Auto" />
    </DockPanel>

    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button x:Name="insertButton" Content="Insert" ToolTip="Paste the reply into the app you came from (Ctrl+Enter)" Click="OnInsert" IsEnabled="False" />
        <Button x:Name="copyButton" Content="Copy" Margin="6,0,0,0" Click="OnCopy" IsEnabled="False" />
        <Button x:Name="retryButton" Content="Retry" Margin="6,0,0,0" Click="OnRetry" IsEnabled="False" />
      </StackPanel>
      <TextBlock x:Name="hintText" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="Enter sends · Shift+Enter new line · Esc closes" />
    </DockPanel>
  </Grid>
</Window>
